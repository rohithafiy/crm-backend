{
  "info": {
    "name": "Portal 5 — CRM & Client Management",
    "description": "LTI Hub — P5 CRM API. Set {{base_url}} = http://localhost:5050 and {{token}} = your JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5050" },
    { "key": "token",    "value": "your_jwt_token_here" },
    { "key": "lead_id",  "value": "" },
    { "key": "client_id","value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/portal5/leads",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Arjun Mehta\",\n  \"email\": \"arjun.mehta@acme.in\",\n  \"phone\": \"+919876543210\",\n  \"source\": \"website\",\n  \"company_name\": \"Acme Corp\",\n  \"industry\": \"Technology\",\n  \"service_type\": \"Web Development\",\n  \"project_description\": \"E-commerce platform rebuild\",\n  \"budget_range\": \"5L-10L\",\n  \"timeline\": \"Q3 2025\",\n  \"estimated_value\": 750000,\n  \"notes\": \"High priority referral\"\n}"
            }
          }
        },
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/portal5/leads?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "portal5", "leads"],
              "query": [
                { "key": "page",   "value": "1" },
                { "key": "limit",  "value": "20" },
                { "key": "status", "value": "", "disabled": true },
                { "key": "search", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Lead by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/portal5/leads/{{lead_id}}"
          }
        },
        {
          "name": "Update Lead",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/portal5/leads/{{lead_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Updated after follow-up call\",\n  \"estimated_value\": 900000\n}"
            }
          }
        },
        {
          "name": "Delete Lead (Soft)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/portal5/leads/{{lead_id}}"
          }
        },
        {
          "name": "Assign Lead",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/portal5/leads/{{lead_id}}/assign",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigned_to\": \"user_id_priya\",\n  \"note\": \"Assigning to Priya for Q3 follow-up\"\n}"
            }
          }
        },
        {
          "name": "Convert Lead to Client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/portal5/leads/{{lead_id}}/convert"
          }
        }
      ]
    },
    {
      "name": "Clients",
      "item": [
        {
          "name": "Create Client",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/portal5/clients",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company_name\": \"Acme Corp Pvt Ltd\",\n  \"contact_person\": \"Arjun Mehta\",\n  \"email\": \"arjun@acme.in\",\n  \"phone\": \"+919876543210\",\n  \"industry\": \"Technology\",\n  \"website\": \"https://acme.in\",\n  \"gst_number\": \"29ABCDE1234F1Z5\",\n  \"address\": {\n    \"street\": \"42 MG Road\",\n    \"city\": \"Bengaluru\",\n    \"state\": \"Karnataka\",\n    \"country\": \"India\",\n    \"pincode\": \"560001\"\n  }\n}"
            }
          }
        },
        {
          "name": "List Clients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/portal5/clients?page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "portal5", "clients"],
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "limit",    "value": "20" },
                { "key": "status",   "value": "active", "disabled": true },
                { "key": "industry", "value": "", "disabled": true },
                { "key": "search",   "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Client by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/portal5/clients/{{client_id}}"
          }
        },
        {
          "name": "Update Client",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/portal5/clients/{{client_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"inactive\",\n  \"total_revenue\": 1500000\n}"
            }
          }
        },
        {
          "name": "Delete Client (Soft)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/portal5/clients/{{client_id}}"
          }
        }
      ]
    },
    {
      "name": "Pipeline",
      "item": [
        {
          "name": "Get Pipeline Board",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/portal5/pipeline"
          }
        },
        {
          "name": "Update Pipeline Stage",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/portal5/pipeline/{{lead_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"qualified\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Communications",
      "item": [
        {
          "name": "Log Communication",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": "{{base_url}}/api/portal5/communications",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"meeting\",\n  \"client_id\": \"{{client_id}}\",\n  \"subject\": \"Kickoff Call\",\n  \"content\": \"Discussed project scope. Client confirmed budget of 7.5L.\",\n  \"attendees\": [\"Arjun Mehta\", \"Priya Singh\"],\n  \"action_items\": [\"Send proposal by Friday\", \"Share NDA\"],\n  \"file_urls\": []\n}"
            }
          }
        },
        {
          "name": "Get Client Communications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{base_url}}/api/portal5/communications/client/{{client_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "portal5", "communications", "client", "{{client_id}}"],
              "query": [
                { "key": "type", "value": "meeting", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Lead Communications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/api/portal5/communications/lead/{{lead_id}}"
          }
        }
      ]
    }
  ]
}
