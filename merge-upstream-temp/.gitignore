# pyenv
#   For a library or app, you might want to share this in the repository so that the people who clone the repo
#   use the same version.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different OS or architectures,
#   it is better to exclude Pipfile.lock and use pipenv install --skip-lock
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is typically recommended to be committed.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is typically recommended to be committed.
# pdm.lock

# virtualenv
.venv
venv/
ENV/
env/
ENV/

