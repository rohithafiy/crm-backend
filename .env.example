# Portal 5 — CRM & Client Management
# Copy this file to .env and fill in your values
# Generate strong secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5050

# MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=lti_crm

# JWT
JWT_SECRET_KEY=your-256-bit-secret-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRY=3600
JWT_REFRESH_TOKEN_EXPIRY=86400

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# SMTP
SMTP_PASSWORD=your_smtp_password_here

# Cloudflare
CLOUD_FLARE_SECRET=your_cloudflare_secret_here

# Portal integrations - replace with real values and use HTTPS in production
PORTAL1_BASE_URL=http://portal1.internal
PORTAL1_API_KEY=CHANGE_ME_portal1_api_key
PORTAL3_BASE_URL=http://portal3.internal
PORTAL3_API_KEY=CHANGE_ME_portal3_api_key
PORTAL6_BASE_URL=http://portal6.internal
PORTAL6_API_KEY=CHANGE_ME_portal6_api_key
PORTAL8_BASE_URL=http://portal8.internal
PORTAL8_API_KEY=CHANGE_ME_portal8_api_key
PORTAL_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
